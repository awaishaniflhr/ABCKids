<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep a child's play history (and every other piece of app data) on this
  phone only: never back it up to the cloud and never copy it to a new phone
  in a device-to-device transfer. A fresh install starts with no progress.
  (Android 12+. Older versions use android:allowBackup="false".)
  An ad-free purchase is restored from Google Play instead.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </device-transfer>
</data-extraction-rules>
